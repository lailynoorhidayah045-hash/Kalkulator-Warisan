{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public-facing user profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication user UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name shown in UI."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Application role assigned safely."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user (email, contact).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "lastLoginAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator allowlist entry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "addedBy", "createdAt"]
    },
    "IdentitySubmission": {
      "title": "IdentitySubmission",
      "description": "User/case identity submitted from the pre-start identity modal.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 150
        },
        "fullName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "deceasedName": {
          "type": "string",
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "contact": {
          "type": "string",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "fullName", "role", "deceasedName", "city", "contact", "notes", "createdAt", "updatedAt"]
    },
    "InheritanceCase": {
      "title": "InheritanceCase",
      "description": "Full inheritance simulation case stored in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "currency": {
          "type": "string",
          "enum": ["IDR", "USD"]
        },
        "exchangeRate": {
          "type": "number"
        },
        "legalSystem": {
          "type": "string",
          "enum": ["islam", "civil"]
        },
        "deceasedGender": {
          "type": "string",
          "enum": ["male", "female"]
        },
        "netEstateSnapshot": {
          "type": "number"
        },
        "financials": {
          "type": "object",
          "description": "Financial inputs map (grossAssets, debts, funeralCosts, willAmount)."
        },
        "family": {
          "type": "object",
          "description": "Family counts map for all 19 heir categories."
        },
        "identity": {
          "type": "object",
          "description": "Associated identity metadata map."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "name",
        "notes",
        "currency",
        "exchangeRate",
        "legalSystem",
        "deceasedGender",
        "netEstateSnapshot",
        "financials",
        "family",
        "identity",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoachLog": {
      "title": "CoachLog",
      "description": "AI Legal Coach Q&A consultation entry persisted in Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "legalSystem": {
          "type": "string",
          "enum": ["islam", "civil"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "ownerName", "question", "answer", "legalSystem", "createdAt"]
    },
    "SimulationLog": {
      "title": "SimulationLog",
      "description": "User simulation activity log with full snapshot for admin audit and printing.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 150
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "legalSystem": {
          "type": "string",
          "enum": ["islam", "civil"]
        },
        "deceasedGender": {
          "type": "string",
          "enum": ["male", "female"]
        },
        "currency": {
          "type": "string",
          "enum": ["IDR", "USD"]
        },
        "exchangeRate": {
          "type": "number"
        },
        "netEstate": {
          "type": "number"
        },
        "financials": {
          "type": "object"
        },
        "family": {
          "type": "object"
        },
        "identity": {
          "type": "object"
        },
        "summaryText": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "action",
        "title",
        "legalSystem",
        "deceasedGender",
        "currency",
        "exchangeRate",
        "netEstate",
        "financials",
        "family",
        "identity",
        "summaryText",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII documents restricted to owner and admins."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin allowlist documents."
    },
    "/identities/{identityId}": {
      "schema": { "$ref": "#/entities/IdentitySubmission" },
      "description": "Submitted case and user identity forms."
    },
    "/cases/{caseId}": {
      "schema": { "$ref": "#/entities/InheritanceCase" },
      "description": "Saved inheritance simulation cases."
    },
    "/coachLogs/{logId}": {
      "schema": { "$ref": "#/entities/CoachLog" },
      "description": "Persisted AI Legal Coach consultation logs."
    },
    "/simulationLogs/{logId}": {
      "schema": { "$ref": "#/entities/SimulationLog" },
      "description": "User simulation logs for admin tracking, editing, export, and PDF printing."
    }
  }
}
